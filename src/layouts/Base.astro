---
/**
 * Head boilerplate. Takes only public strings: metadata is the easiest place to
 * leak private data, because nothing on screen shows you it happened.
 */
import Vault from '../components/Vault.astro';
import { locales, langs, localeHref } from '../i18n';
import type { Lang } from '../i18n/types';
import '../styles/cv.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = locales[lang];

const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Hanken+Grotesk:wght@400;500;600&display=swap';
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.name} — {c.headline}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="robots" content="noarchive, noimageindex, nosnippet" />
    <link rel="icon" href="data:," />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={locales[l].htmlLang} href={new URL(localeHref(locales[l].base), Astro.site)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body>
    <slot />
    <Vault />
  </body>
</html>
